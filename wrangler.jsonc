{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "quest-log",
  "main": "src/worker/worker.ts",
  "compatibility_date": "2026-10-01",
  // lets the OAuth provider fetch Client ID Metadata Documents safely
  "compatibility_flags": ["global_fetch_strictly_public"],
  // Bundles the browser app (src/client) into public/ before every deploy and dev run.
  "build": { "command": "npm run build", "watch_dir": "src/client" },
  // The PWA is served as static assets; API, MCP and OAuth routes go to the Worker first.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/mcp", "/mcp/*", "/authorize", "/oauth/*", "/.well-known/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "quest-log",
      "database_id": "6b432abd-c808-43c6-9284-67fad0c6752a",
    },
  ],
  // Check for due reminders every 5 minutes.
  "triggers": {
    "crons": ["*/5 * * * *"],
  },
  "vars": {
    "VAPID_PUBLIC_KEY": "BBHjrikzs2-jaIDh0kT1KldzkezFXpnU2EEbz2kN5iaQb_yLd2vk6-Bv1kQ1WTBVErdRvjSzeCNr7ZnZGuAFeB4",
    "VAPID_SUBJECT": "mailto:hire.jerry.vrabel@gmail.com",
  },
  // Moment files (photos, videos, music, recordings), encrypted on the device before upload.
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "quest-log-media",
    },
  ],
  // Rate limits (#64, src/worker/limits.ts). namespace_id is any number unique in the account.
  "ratelimits": [
    { "name": "API_LIMIT", "namespace_id": "6401", "simple": { "limit": 120, "period": 60 } },
    { "name": "MEDIA_LIMIT", "namespace_id": "6402", "simple": { "limit": 30, "period": 60 } },
    { "name": "MCP_LIMIT", "namespace_id": "6403", "simple": { "limit": 60, "period": 60 } },
    { "name": "AUTH_LIMIT", "namespace_id": "6404", "simple": { "limit": 10, "period": 60 } },
  ],
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "619e3c07b4fd4f62a1738230a1a55e9a",
    },
  ],
  // VAPID_PRIVATE_JWK is a secret: npx wrangler secret put VAPID_PRIVATE_JWK

  // Staging (#25): a second Worker, quest-log-staging, built from the dev branch. Its own database,
  // OAuth store, media bucket, rate-limit counters and push keys, so nothing tested there touches
  // real data. Bindings and vars are not inherited by an environment, so each is listed again.
  // Deploy: npm run deploy:staging. Secret: npx wrangler secret put VAPID_PRIVATE_JWK --env staging
  "env": {
    "staging": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "quest-log-staging",
          "database_id": "3c5b64b8-4f52-44cf-9c16-8efbbeca887e",
        },
      ],
      "vars": {
        "VAPID_PUBLIC_KEY": "BAq7yR-Z0WU9b2cyJPZFWzC1JknngJa9aPCnmdFrWuzhkujFqXa11K_K0FZ3dzMrnGRPX3-36AMCwbGnbG1T_KE",
        "VAPID_SUBJECT": "mailto:hire.jerry.vrabel@gmail.com",
      },
      "r2_buckets": [
        {
          "binding": "MEDIA",
          "bucket_name": "quest-log-media-staging",
        },
      ],
      "ratelimits": [
        { "name": "API_LIMIT", "namespace_id": "6411", "simple": { "limit": 120, "period": 60 } },
        { "name": "MEDIA_LIMIT", "namespace_id": "6412", "simple": { "limit": 30, "period": 60 } },
        { "name": "MCP_LIMIT", "namespace_id": "6413", "simple": { "limit": 60, "period": 60 } },
        { "name": "AUTH_LIMIT", "namespace_id": "6414", "simple": { "limit": 10, "period": 60 } },
      ],
      "kv_namespaces": [
        {
          "binding": "OAUTH_KV",
          "id": "66fb199651fb441abb59588c3d8278c9",
        },
      ],
    },
  },
}

{
  "name": "quest-log",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "node scripts/build.mjs",
    "build:watch": "node scripts/build.mjs --watch",
    "deploy": "wrangler deploy",
    "types": "wrangler types --env-interface Env --strict-vars=false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.sw.json && tsc -p tsconfig.worker.json && tsc -p tsconfig.e2e.json",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test",
    "serve:static": "node scripts/serve-static.mjs",
    "vapid": "node scripts/gen-vapid.mjs",
    "db:init": "wrangler d1 execute quest-log --remote --file=schema.sql",
    "db:init:local": "wrangler d1 execute quest-log --local --file=schema.sql"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@cloudflare/workers-types": "^5.20261022.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.56.1",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^4.1.12",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5",
    "wrangler": "^4"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^1.2.3"
  },
  "engines": {
    "node": ">=22.5"
  },
  "overrides": {
    "undici": "7.30.1"
  }
}
